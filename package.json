{
  "name": "pathfinder",
  "displayName": "PathFinder",
  "description": "Right-click a function to see every call path that leads to it.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Debuggers"
  ],
  "main": "./out/extension.js",
  "activationEvents": ["onDebug"],
  "contributes": {
    "commands": [
      {
        "command": "pathfinder.pathFind",
        "title": "PathFind"
      },
      {
        "command": "pathfind.testGraph",
        "title": "PathFind: Test Graph"
      },
      {
        "command": "pathfind.testWorkspaceGraph",
        "title": "PathFind: Test Graph with Workspace Paths"
      },
      {
        "command": "pathfind.testDebugPath",
        "title": "PathFind: Test Debug Path"
      },
      {
        "command": "pathfind.clearDebugPath",
        "title": "PathFind: Clear Debug Path"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pathfinder.pathFind",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && tsc -p tsconfig.webview.json && npm run build:webview",
    "watch": "tsc -watch -p ./",
    "build:webview": "esbuild media/graph.ts --bundle --platform=browser --outfile=out/webview/graph.js",
    "watch:webview": "npm run build:webview -- --watch",
    "vscode:prepublish": "npm run compile",
    "test": "tsc -p ./ && node out/test/runTest.js",
    "test:unit": "tsc -p ./ && node out/test/recursion.unit.js && node out/test/targetLayout.unit.js && npm run test:renderer",
    "test:renderer": "tsc -p tsconfig.webview.json && esbuild media/graph.test.ts --bundle --platform=node --outfile=out/test/graphRenderer.unit.js && node out/test/graphRenderer.unit.js"
  },
  "devDependencies": {
    "@types/cytoscape-fcose": "^2.2.5",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "cytoscape": "^3.34.3",
    "cytoscape-fcose": "^2.2.0"
  }
}
