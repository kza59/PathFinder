{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run PathFinder",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extension=ms-toolsai.jupyter",
        "${workspaceFolder}/${input:fixture}"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ],
  "inputs": [
    {
      "id": "fixture",
      "type": "pickString",
      "description": "Folder to open in the Extension Development Host",
      "options": ["test1", "test2", "test3", "test4/python", "test4/cpp", "test6"],
      "default": "test1"
    }
  ]
}
