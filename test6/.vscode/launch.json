{
  "version": "0.2.0",
  "configurations": [
    {
      // Always runs main.py, whichever file is open (running sum.py on its own only defines sum and exits).
      "name": "Debug main",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    }
  ]
}
