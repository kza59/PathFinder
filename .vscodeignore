# Files left out of the .vsix. Everything not listed here ships.
# Runtime needs: out/extension.js + out/webview/** (bundles), python/**, gdb/**, media/*.css,
# package.json, README.md, LICENSE.

# Private local settings (Claude Code) - must never ship
.claude/**

# Editor / VCS / tooling
.vscode/**
.vscode-test/**
.git/**
.gitignore
**/*.vsix
tsconfig*.json

# Sources (the compiled output in out/ is what runs)
src/**
media/**/*.ts

# Tests and test fixtures
**/*.test.ts
**/*.unit.ts
test1/**
test2/**
test3/**
test4/**
test5/**
test6/**
test7/**
test8/**
test9/**
test10/**
# Compiled tests. extension.js is an esbuild bundle (npm run build:extension) that already contains everything it
# imports, including the AI SDKs from node_modules, so the rest of tsc's out/ isn't needed either.
out/test/**

# Not needed at runtime
node_modules/**
**/*.map
**/__pycache__/**
example*.png
